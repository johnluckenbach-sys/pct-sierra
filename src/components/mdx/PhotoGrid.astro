---
import { cdnThumb, cdnFull } from '../../lib/cloudinary';

interface Photo {
  src?: string;   // full URL (local or external)
  id?: string;    // Cloudinary public ID  e.g. "trips/desolation-loop/day1"
  alt?: string;
  caption?: string;
}

interface Props {
  photos: Photo[];
  caption?: string;
  cols?: 2 | 3;
}

const { photos, caption, cols = 2 } = Astro.props;
const gridClass = cols === 3 ? 'sm:grid-cols-3' : 'sm:grid-cols-2';

function thumbSrc(p: Photo) {
  return p.id ? cdnThumb(p.id, 800) : p.src!;
}
function fullSrc(p: Photo) {
  return p.id ? cdnFull(p.id) : p.src!;
}
---

<figure class="my-8 not-prose">
  <div class={`grid grid-cols-1 ${gridClass} gap-2`}>
    {photos.map((photo, i) => (
      <button
        class="gallery-item group relative overflow-hidden rounded-lg aspect-[4/3] bg-stone-100 cursor-zoom-in"
        data-index={String(i)}
        data-src={fullSrc(photo)}
        data-alt={photo.alt ?? ''}
        data-caption={photo.caption ?? ''}
      >
        <img
          src={thumbSrc(photo)}
          alt={photo.alt ?? ''}
          loading="lazy"
          decoding="async"
          class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
        />
        {photo.caption && (
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-3 translate-y-full group-hover:translate-y-0 transition-transform duration-300">
            <p class="text-white text-xs">{photo.caption}</p>
          </div>
        )}
      </button>
    ))}
  </div>
  {caption && (
    <figcaption class="mt-2 text-center text-sm text-stone-400 italic">{caption}</figcaption>
  )}
</figure>
