---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import TripCard from '../../components/TripCard.astro';

const allTrips = await getCollection('trips');
const trips = allTrips.sort((a, b) => a.data.year - b.data.year);

const totalMiles = trips.reduce((sum, t) => sum + t.data.miles, 0);
const totalDays = trips.reduce((sum, t) => sum + t.data.days, 0);
const totalGain = trips.reduce((sum, t) => sum + (t.data.elevationGain ?? 0), 0);
---

<Layout title="All Trips — PCT Sierra">
  <Header />

  <main class="pt-20 pb-16 px-4 sm:px-6 min-h-screen">
    <div class="max-w-6xl mx-auto">
      <!-- Page header -->
      <div class="py-12 border-b border-stone-200 mb-10">
        <p class="text-amber-600 text-sm font-medium tracking-widest uppercase mb-2">PCT · Mi 702–1090</p>
        <h1 class="text-4xl font-bold text-stone-900 mb-4" style="font-family: 'Lora', serif;">All Trips</h1>
        <p class="text-stone-500 text-lg max-w-2xl">
          Six years of long weekends through the Sierra Nevada, from Kennedy Meadows to Echo Lake.
        </p>
        <!-- Stats -->
        <div class="flex flex-wrap gap-8 mt-8">
          <div>
            <div class="text-3xl font-bold text-stone-800">{totalMiles}</div>
            <div class="text-xs uppercase tracking-wider text-stone-400 mt-0.5">Total Miles</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-stone-800">{totalDays}</div>
            <div class="text-xs uppercase tracking-wider text-stone-400 mt-0.5">Days on Trail</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-stone-800">{totalGain.toLocaleString()}</div>
            <div class="text-xs uppercase tracking-wider text-stone-400 mt-0.5">Feet of Gain</div>
          </div>
          <div>
            <div class="text-3xl font-bold text-stone-800">{trips.length}</div>
            <div class="text-xs uppercase tracking-wider text-stone-400 mt-0.5">Trips</div>
          </div>
        </div>
      </div>

      <!-- Trip grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {trips.map(trip => (
          <TripCard
            slug={trip.id}
            title={trip.data.title}
            year={trip.data.year}
            days={trip.data.days}
            miles={trip.data.miles}
            startPoint={trip.data.startPoint}
            endPoint={trip.data.endPoint}
            pctMileStart={trip.data.pctMileStart}
            pctMileEnd={trip.data.pctMileEnd}
            description={trip.data.description}
            color={trip.data.color}
            tags={trip.data.tags}
          />
        ))}
      </div>
    </div>
  </main>

  <Footer />
</Layout>
