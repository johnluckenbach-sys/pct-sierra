---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Map from '../components/Map.astro';
import { fetchTripSheet, mergeSheetData } from '../lib/trip-sheet';

const sheetUrl  = import.meta.env.SHEET_CSV_URL;
const sheet     = sheetUrl ? await fetchTripSheet(sheetUrl) : {};

const allTrips  = await getCollection('trips');
const trips     = allTrips
  .map(t => ({ ...t, data: mergeSheetData(t.data, sheet[t.id]) }))
  .sort((a, b) => a.data.year - b.data.year);

// Assign a 4-color palette sorted south→north so adjacent routes
// never share a similar color. Trips with unknown PCT miles go last.
const MAP_PALETTE = ['#e07b39', '#2563eb', '#db2777', '#0d9488', '#d97706', '#7c3aed'];
const geoSorted = [...allTrips].sort((a, b) => {
  const aM = a.data.pctMileStart || Infinity;
  const bM = b.data.pctMileStart || Infinity;
  return aM - bM;
});
const paletteColor: Record<string, string> = {};
geoSorted.forEach((t, i) => { paletteColor[t.id] = MAP_PALETTE[i % MAP_PALETTE.length]; });

const mapTrips = trips.map(t => ({
  slug: t.id,
  title: t.data.title,
  year: t.data.year,
  days: t.data.days,
  miles: t.data.miles,
  startPoint: t.data.startPoint,
  endPoint: t.data.endPoint,
  description: t.data.description,
  coordinates: t.data.coordinates,
  color: paletteColor[t.id] ?? t.data.color,
  routeFile: t.data.routeFile,
}));

const totalMiles = trips.reduce((sum, t) => sum + t.data.miles, 0);
const totalDays = trips.reduce((sum, t) => sum + t.data.days, 0);
---

<Layout>
  <Header />

  <!-- Hero: full-viewport map, overlaid by fixed header and bottom nav -->
  <section class="relative h-screen">
    <Map trips={mapTrips} class="absolute inset-0" />

    <!-- Overlay title -->
    <div class="absolute bottom-0 left-0 right-0 pointer-events-none">
      <div class="bg-gradient-to-t from-stone-900/80 via-stone-900/40 to-transparent pt-24 pb-20 px-6">
        <div class="max-w-6xl mx-auto">
          <h1 class="text-white text-4xl sm:text-5xl font-bold leading-tight mb-3" style="font-family: 'Lora', serif;">
            The PCT, One Weekend at a Time
          </h1>
          <p class="text-stone-300 text-base sm:text-lg max-w-xl mb-6">
            Hiking from Kennedy Meadows to Donner Pass and beyond, one weekend at a time.
          </p>
          <!-- Stats bar -->
          <div class="flex flex-wrap items-center gap-6 pointer-events-auto">
            <div class="flex items-center gap-1.5">
              <span class="text-white text-xl font-semibold">{totalMiles}</span>
              <span class="text-stone-400 text-xs uppercase tracking-wider">Miles</span>
            </div>
            <div class="w-px h-4 bg-stone-600"></div>
            <div class="flex items-center gap-1.5">
              <span class="text-white text-xl font-semibold">{trips.length}</span>
              <span class="text-stone-400 text-xs uppercase tracking-wider">Trips</span>
            </div>
            <div class="w-px h-4 bg-stone-600"></div>
            <div class="flex items-center gap-1.5">
              <span class="text-white text-xl font-semibold">{totalDays}</span>
              <span class="text-stone-400 text-xs uppercase tracking-wider">Days on Trail</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom navigation bar -->
  <nav class="fixed bottom-0 left-0 right-0 z-50 bg-stone-900/90 backdrop-blur-sm border-t border-stone-700">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 flex items-center justify-center h-14 gap-1">
      <a href="/" class="px-3 py-1.5 rounded text-sm transition-colors text-amber-400 bg-stone-800">Map</a>
      <a href="/trips" class="px-3 py-1.5 rounded text-sm transition-colors text-stone-300 hover:text-white hover:bg-stone-800">All Trips</a>
      <a href="/about" class="px-3 py-1.5 rounded text-sm transition-colors text-stone-300 hover:text-white hover:bg-stone-800">About</a>
    </div>
  </nav>
</Layout>

<style is:global>
  html, body {
    overflow: hidden;
    height: 100%;
  }
</style>
